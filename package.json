{
  "name": "even-g2-status",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "Even Realities G2 always-on status HUD plugin",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "qr": "evenhub qr --port 5173",
    "pack": "npm run build && evenhub pack app.json dist -o g2-status.ehpk",
    "version": "node scripts/version.mjs sync && git add app.json",
    "ci-login": "node scripts/ci-login.mjs"
  },
  "engines": {
    "node": "^20.17.0 || >=22.13.0"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.16"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "0.2.0",
    "@types/node": "^22.20.5",
    "js-yaml": "4.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
